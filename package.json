{
  "name": "dsh-purge",
  "version": "1.1.78-compat.2",
  "description": "dsh-purge compatibility build preserving official DSH permissions, sandbox and approvals; based on YuJunZhiXue/dsh-purge.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbang80808-wq/dsh-purge.git"
  },
  "homepage": "https://github.com/bigbang80808-wq/dsh-purge/tree/codex/preserve-official-permissions-20261027",
  "bugs": {
    "url": "https://github.com/bigbang80808-wq/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/bigbang80808-wq/dsh-purge/tar.gz/refs/heads/codex/preserve-official-permissions-20261027",
      "zip": "https://codeload.github.com/bigbang80808-wq/dsh-purge/zip/refs/heads/codex/preserve-official-permissions-20261027",
      "git": "https://github.com/bigbang80808-wq/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.3",
  "compatibility": {
    "mode": "official-permissions",
    "baseCommit": "bde36403e909e4cf288e447de11f7a390c337480",
    "buildId": "official-permissions-prompt-save-20261027",
    "hostPatching": false,
    "upstreamSelfUpdate": false
  }
}
